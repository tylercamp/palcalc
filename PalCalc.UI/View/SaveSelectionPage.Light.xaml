<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI">
    <SolidColorBrush x:Key="SaveVirtualIconBrush"
                     Color="{DynamicResource {x:Static adonisUi:Colors.AccentColor}}" />
    <SolidColorBrush x:Key="SaveFolderIconBrush"
                     Color="{DynamicResource {x:Static adonisUi:Colors.AlertColor}}" />
    <SolidColorBrush x:Key="SaveCountForegroundBrush"
                     Color="{DynamicResource {x:Static adonisUi:Colors.DisabledForegroundColor}}" />
</ResourceDictionary>
