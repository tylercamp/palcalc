<UserControl x:Class="PalCalc.UI.View.Main.BreedableToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vms="clr-namespace:PalCalc.UI.ViewModel.Solver"
             xmlns:vp="clr-namespace:PalCalc.UI.View.Pal"
             xmlns:vu="clr-namespace:PalCalc.UI.View.Utils"
             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
             xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <c:ValueVisibilityConverter x:Key="VVC" />
        <c:ValueVisibilityConverter x:Key="NegatedVVC" Negate="True" />

        <!-- Mirrors the location popup for pal nodes in BreedingResultView -->
        <DataTemplate x:Key="ParentPopupContent">
            <vu:PopupToolTipContent Background="{DynamicResource BreedingPopupBackgroundBrush}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </StackPanel.Resources>

                    <TextBlock Text="{itl:LocalizedText LC_BREEDABLE_PARENT_BRED}" Visibility="{Binding IsOwned, Converter={StaticResource NegatedVVC}}" />

                    <StackPanel Visibility="{Binding IsOwned, Converter={StaticResource VVC}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pal.Name.Value}" />
                            <vp:PalGenderView DataContext="{Binding Gender}" Height="14" Margin="2,0,0,0" />
                        </StackPanel>
                        <vp:PalIVsView Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" FontSize="9" IV_HP="{Binding IVs.HP}" IV_Attack="{Binding IVs.Attack}" IV_Defense="{Binding IVs.Defense}" />

                        <StackPanel DataContext="{Binding Location}">
                            <TextBlock Text="{Binding LocationOwnerDescription.Value}" FontSize="10" Visibility="{Binding OwnerVisibility}" />
                            <TextBlock Text="{Binding LocationCoordDescription.Value}" FontSize="10" />
                            <vp:PalLocationView DataContext="{Binding MapLocationPreview}" Visibility="{Binding Converter={StaticResource VVC}}" Width="300" Height="300" />
                            <vp:PalLocationView DataContext="{Binding ContainerLocationPreview}" Visibility="{Binding Converter={StaticResource VVC}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </vu:PopupToolTipContent>
        </DataTemplate>

        <DataTemplate x:Key="ParentTemplate">
            <vu:PopupToolTipTrigger Cursor="Hand" InitialShowDelay="200" PopupAnimation="None" ToolTipContentTemplate="{StaticResource ParentPopupContent}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Pal.Name.Value}" FontSize="10" />
                    <vp:PalGenderView DataContext="{Binding Gender}" Visibility="{Binding Converter={StaticResource VVC}}" Height="10" Margin="2,0,0,0" />
                </StackPanel>
            </vu:PopupToolTipTrigger>
        </DataTemplate>

        <DataTemplate x:Key="CardTemplate">
            <Border Margin="5"
                    Padding="7"
                    Width="210"
                    BorderThickness="2"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1IntenseHighlightBorderBrush}}"
                    Background="{DynamicResource BreedingNodeBackgroundBrush}"
                    UseLayoutRounding="True">
                <DockPanel>
                    <Border Width="50" Height="50"
                            CornerRadius="25"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1IntenseHighlightBorderBrush}}"
                            Margin="0,0,5,0"
                            VerticalAlignment="Top"
                            Background="{Binding Pal.IconBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Pal.Name.Value}" />
                        <ContentControl Content="{Binding Parent1}" ContentTemplate="{StaticResource ParentTemplate}" Visibility="{Binding Parent1, Converter={StaticResource VVC}}" Margin="0,2,0,0" />
                        <ContentControl Content="{Binding Parent2}" ContentTemplate="{StaticResource ParentTemplate}" Visibility="{Binding Parent2, Converter={StaticResource VVC}}" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,5"
                Padding="5"
                Background="{DynamicResource ResourceKey={x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DataContext="{Binding SolverControls}">
                <TextBlock Text="{itl:LocalizedText Code=LC_SOLVER_SETTINGS_USE_GENDER_REVERSERS}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <CheckBox IsChecked="{Binding UseGenderReversers, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Margin="0,0,25,0"
                          ToolTipService.ToolTip="{itl:LocalizedText Code=LC_SOLVER_SETTINGS_USE_GENDER_REVERSERS_DESCRIPTION}" />
                <Button Content="{itl:LocalizedText LC_SOLVER_RUN}" Command="{Binding RunSolverCommand}" />
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="{itl:LocalizedText LC_BREEDABLE_CALCULATING}"
                   Visibility="{Binding IsCalculating, Converter={StaticResource VVC}}"
                   Margin="5" />

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vms:BreedableGroupViewModel">
                        <Expander Header="{Binding Title.Value}" IsExpanded="{Binding IsExpanded, Mode=OneTime}" Margin="0,0,0,5">
                            <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
