<adonisControls:AdonisWindow x:Class="PalCalc.UI.View.Main.SolverToolWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:v="clr-namespace:PalCalc.UI.View.Main"
                             xmlns:vms="clr-namespace:PalCalc.UI.ViewModel.Solver"
                             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:behaviors="clr-namespace:PalCalc.UI.View.Behaviors"
                             mc:Ignorable="d"
                             d:DataContext="{d:DesignInstance Type=vms:SolverToolWindowViewModel}"
                             WindowStartupLocation="CenterOwner"
                             IconVisibility="Collapsed"
                             Title="{Binding Tool.Name.Value}"
                             Width="1400" Height="850"
                             MinWidth="960" MinHeight="400"
                             behaviors:WindowPlacementBehavior.Key="SolverTool"
                             behaviors:WindowPlacementBehavior.Mode="SizeAndState">
    <adonisControls:AdonisWindow.Resources>
        <!-- One template per tool -->
        <DataTemplate DataType="{x:Type vms:BreedableToolViewModel}">
            <v:BreedableToolView />
        </DataTemplate>
    </adonisControls:AdonisWindow.Resources>

    <!-- (the default size fits two cards per row, and the minimum fits one beside Source Pals) -->
    <Border Padding="5">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="640" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="280" MinWidth="220" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Content="{Binding Tool}" Focusable="False" />

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

            <!-- Same Source Pals as the solver page, so a tool can be checked against other filters without closing it -->
            <GroupBox Grid.Column="2" Header="{itl:LocalizedText LC_SOURCE_PALS}">
                <!-- (wraps the filter text when the column is narrow) -->
                <ScrollViewer Padding="0" HorizontalScrollBarVisibility="Disabled">
                    <v:SourcePalsView DataContext="{Binding SourcePals}" />
                </ScrollViewer>
            </GroupBox>
        </Grid>
    </Border>
</adonisControls:AdonisWindow>
