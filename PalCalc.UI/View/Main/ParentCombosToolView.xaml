<UserControl x:Class="PalCalc.UI.View.Main.ParentCombosToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="clr-namespace:PalCalc.UI"
             xmlns:vms="clr-namespace:PalCalc.UI.ViewModel.Solver"
             xmlns:mvm="clr-namespace:PalCalc.UI.ViewModel.Mapped"
             xmlns:vp="clr-namespace:PalCalc.UI.View.Pal"
             xmlns:vu="clr-namespace:PalCalc.UI.View.Utils"
             xmlns:itl="clr-namespace:PalCalc.UI.Localization"
             xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
             xmlns:dnkc="clr-namespace:DotNetKit.Windows.Controls;assembly=DotNetKit.Wpf.AutoCompleteComboBox"
             xmlns:materialIcons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:adonisExtensions="clr-namespace:AdonisUI.Extensions;assembly=AdonisUI"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <c:ValueVisibilityConverter x:Key="VVC" />
        <mvm:RankColorConverter x:Key="RCC" />
        <c:ValueVisibilityConverter x:Key="NegatedVVC" Negate="True" />
        <c:ValueVisibilityConverter x:Key="NegatedHiddenVVC" Negate="True" FalseyVisibility="Hidden" />

        <!-- Mirrors the location popup for pal nodes in BreedingResultView, same as BreedableToolView -->
        <DataTemplate x:Key="ParentPopupContent">
            <vu:PopupToolTipContent Background="{DynamicResource BreedingPopupBackgroundBrush}">
                <StackPanel>
                    <StackPanel.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontSize" Value="13" />
                        </Style>
                    </StackPanel.Resources>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Pal.Name.Value}" />
                        <vp:PalGenderView DataContext="{Binding Gender}" Height="14" Margin="2,0,0,0" />
                    </StackPanel>
                    <vp:PalIVsView Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}" FontSize="9" IV_HP="{Binding IVs.HP}" IV_Attack="{Binding IVs.Attack}" IV_Defense="{Binding IVs.Defense}" />

                    <StackPanel DataContext="{Binding Location}">
                        <vp:PalLocationView DataContext="{Binding MapLocationPreview}" Visibility="{Binding Converter={StaticResource VVC}}" Width="300" Height="300" />
                        <vp:PalLocationView DataContext="{Binding ContainerLocationPreview}" Visibility="{Binding Converter={StaticResource VVC}}" />
                    </StackPanel>
                </StackPanel>
            </vu:PopupToolTipContent>
        </DataTemplate>

        <!-- Crosshairs icon beside the location, the same as BreedingResultView. (a grid, so long text still trims) -->
        <DataTemplate x:Key="LocationTemplate">
            <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding LocationOwnerDescription.Value}" FontSize="10" TextTrimming="CharacterEllipsis" Visibility="{Binding OwnerVisibility}" />
                    <TextBlock Text="{Binding LocationCoordDescription.Value}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <materialIcons:MaterialIcon Grid.Column="1" Visibility="{Binding HasPreview, Converter={StaticResource VVC}}" Kind="Crosshairs" Height="10" VerticalAlignment="Center" Margin="5,0,0,0" />
            </Grid>
        </DataTemplate>

        <!-- Only built while "Show IVs" is checked -->
        <DataTemplate x:Key="ParentIVsTemplate">
            <vp:PalIVsView Visibility="{Binding Converter={StaticResource VVC}}"
                           Columns="1"
                           Orientation="Horizontal"
                           Margin="0,2,0,0"
                           Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                           FontSize="10"
                           IV_HP="{Binding HP}"
                           IV_Attack="{Binding Attack}"
                           IV_Defense="{Binding Defense}" />
        </DataTemplate>

        <!-- The IVs the child can have from this pair, also only built while "Show IVs" is checked -->
        <DataTemplate x:Key="ChildIVsTemplate">
            <StackPanel Visibility="{Binding Converter={StaticResource VVC}}">
                <TextBlock Text="{itl:LocalizedText LC_COMBOS_CHILD}" FontWeight="Bold" FontSize="12" />
                <vp:PalIVsView Columns="1"
                               Orientation="Horizontal"
                               Margin="0,2,0,0"
                               Foreground="{DynamicResource {x:Static adonisUi:Brushes.ForegroundBrush}}"
                               FontSize="10"
                               IV_HP="{Binding HP}"
                               IV_Attack="{Binding Attack}"
                               IV_Defense="{Binding Defense}" />
            </StackPanel>
        </DataTemplate>

        <!-- (the template is only set while "Show IVs" is checked, so the IV views aren't built at all otherwise.
             each template hides itself when there are no IVs, e.g. for a parent which isn't owned) -->
        <Style x:Key="ShowParentIVs" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowIVs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Content" Value="{Binding IVs}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource ParentIVsTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ShowChildIVs" TargetType="ContentControl">
            <Setter Property="Focusable" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.ShowIVs, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                    <Setter Property="Content" Value="{Binding IVs}" />
                    <Setter Property="ContentTemplate" Value="{StaticResource ChildIVsTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Icon, name, IVs and location of one parent. A parent which needs to be bred has no specific pal, so it has no popup. -->
        <DataTemplate x:Key="ParentTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="40" Height="40"
                        CornerRadius="20"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1IntenseHighlightBorderBrush}}"
                        Margin="0,0,6,0"
                        VerticalAlignment="Top"
                        Background="{Binding Pal.IconBrush}" />

                <vu:PopupToolTipTrigger Grid.Column="1"
                                        HorizontalAlignment="Left"
                                        IsEnabled="{Binding IsOwned}"
                                        Cursor="Hand"
                                        InitialShowDelay="200"
                                        PopupAnimation="None"
                                        ToolTipContentTemplate="{StaticResource ParentPopupContent}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Pal.Name.Value}" FontWeight="Bold" FontSize="12" TextTrimming="CharacterEllipsis" />
                            <vp:PalGenderView DataContext="{Binding Gender}" Visibility="{Binding Converter={StaticResource VVC}}" Height="11" Margin="2,0,0,0" />
                            <!-- Same swap icon as PalGenderView, shown when the owned pal is the other gender -->
                            <materialIcons:MaterialIcon Kind="SwapHorizontal"
                                                        Height="11"
                                                        Margin="1,0,0,0"
                                                        ToolTip="{itl:LocalizedText Code=LC_SOLVER_SETTINGS_USE_GENDER_REVERSERS}"
                                                        Visibility="{Binding NeedsReverser, Converter={StaticResource VVC}}" />
                            <!-- Philanthropist, in its passive rank color, kept in this row so cards stay the same height -->
                            <materialIcons:MaterialIcon Kind="HandHeart"
                                                        Height="12"
                                                        Margin="2,0,0,0"
                                                        Background="Transparent"
                                                        Foreground="{Binding BreedSpeedPassive.Rank, Converter={StaticResource RCC}}"
                                                        ToolTip="{Binding BreedSpeedPassive.Name.Value}"
                                                        Visibility="{Binding BreedSpeedPassive, Converter={StaticResource VVC}}" />
                        </StackPanel>

                        <ContentControl Style="{StaticResource ShowParentIVs}" />

                        <!-- How to get a parent which isn't owned -->
                        <TextBlock Text="{Binding Hint.Value}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding Hint, Converter={StaticResource VVC}}" />

                        <ContentControl Content="{Binding Location}"
                                        ContentTemplate="{StaticResource LocationTemplate}"
                                        Margin="0,2,0,0"
                                        Visibility="{Binding Location, Converter={StaticResource VVC}}" />
                    </StackPanel>
                </vu:PopupToolTipTrigger>
            </Grid>
        </DataTemplate>

        <!-- Every card has the same width so they line up, the window's minimum width keeps one from being cut off -->
        <DataTemplate x:Key="CardTemplate">
            <Border Width="420"
                    UseLayoutRounding="True"
                    Padding="7"
                    BorderThickness="2"
                    CornerRadius="10"
                    BorderBrush="{DynamicResource {x:Static adonisUi:Brushes.Layer1IntenseHighlightBorderBrush}}"
                    Background="{DynamicResource BreedingNodeBackgroundBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ContentControl Grid.Column="0" Content="{Binding Parent1}" ContentTemplate="{StaticResource ParentTemplate}" Margin="0,0,8,0" />
                    <ContentControl Grid.Column="1" Content="{Binding Parent2}" ContentTemplate="{StaticResource ParentTemplate}" Margin="0,0,8,0" />

                    <!-- The IVs the child can have from this pair, when both parents are owned -->
                    <ContentControl Grid.Column="2" Style="{StaticResource ShowChildIVs}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Margin="0,0,0,5"
                Padding="5"
                Background="{DynamicResource ResourceKey={x:Static adonisUi:Brushes.Layer1BackgroundBrush}}"
                adonisExtensions:LayerExtension.IncreaseLayer="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MaxWidth="250" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="10" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="{itl:LocalizedText LC_COMBOS_CHILD}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <dnkc:AutoCompleteComboBox Grid.Column="1"
                                           VerticalAlignment="Center"
                                           ItemsSource="{Binding ChildOptions}"
                                           SelectedValue="{Binding Child, Mode=TwoWay}"
                                           TextSearch.TextPath="Label.Value">
                    <dnkc:AutoCompleteComboBox.ItemTemplate>
                        <DataTemplate DataType="mvm:PalViewModel">
                            <TextBlock Text="{Binding Label.Value}" />
                        </DataTemplate>
                    </dnkc:AutoCompleteComboBox.ItemTemplate>
                </dnkc:AutoCompleteComboBox>

                <Label Grid.Column="2" Content="{itl:LocalizedText LC_COMBOS_SORT}" VerticalAlignment="Center" Margin="20,0,10,0" />
                <ComboBox Grid.Column="3" VerticalAlignment="Center" MinWidth="110" ItemsSource="{Binding SortOptions}" SelectedValue="{Binding SelectedSort, Mode=TwoWay}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vms:ParentComboSortOption">
                            <TextBlock Text="{Binding Label.Value}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Grid.Column="5" Orientation="Horizontal">
                    <TextBlock Text="{itl:LocalizedText Code=LC_SOLVER_SETTINGS_USE_GENDER_REVERSERS}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding SolverControls.UseGenderReversers, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,25,0"
                              ToolTipService.ToolTip="{itl:LocalizedText Code=LC_SOLVER_SETTINGS_USE_GENDER_REVERSERS_DESCRIPTION}" />
                    <TextBlock Text="{itl:LocalizedText Code=LC_TOOL_SHOW_IVS}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <CheckBox IsChecked="{Binding ShowIVs}" VerticalAlignment="Center" Margin="0,0,25,0" />
                    <!-- (the window runs the tool, since it has the Source Pals and settings to run with) -->
                    <Button Content="{itl:LocalizedText LC_SOLVER_RUN}" Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock DockPanel.Dock="Top"
                   Text="{itl:LocalizedText LC_COMBOS_CHOOSE_CHILD}"
                   HorizontalAlignment="Center"
                   Margin="0,40,0,0"
                   Visibility="{Binding Child, Converter={StaticResource NegatedVVC}}" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Contents, click a group to scroll to it. Same as `BreedableToolView`, without the search pulse -->
            <ListBox x:Name="GroupsContents"
                     Grid.Column="0"
                     Margin="0,0,5,0"
                     ItemsSource="{Binding Groups}"
                     SelectionChanged="GroupsContents_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Visibility="{Binding IsLoading, Converter={StaticResource NegatedHiddenVVC}}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <!-- (selecting handles the keyboard, this handles clicking the group that's already selected) -->
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="GroupsContents_ItemClicked" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="vms:ParentComboGroupViewModel">
                        <TextBlock Text="{Binding Title.Value}" TextWrapping="Wrap" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Hidden rather than collapsed while loading, so the cards are still laid out as they're added -->
            <ScrollViewer x:Name="GroupsScrollViewer"
                          Grid.Column="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsLoading, Converter={StaticResource NegatedHiddenVVC}}"
                          IsVisibleChanged="Groups_IsVisibleChanged">
                <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vms:ParentComboGroupViewModel">
                            <GroupBox Header="{Binding Title.Value}" Margin="0,0,0,5">
                                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Margin="2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <vu:SpacedWrapPanel Orientation="Horizontal" HorizontalSpacing="10" VerticalSpacing="10" HorizontalContentAlignment="Left" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- The same loading animation as the app's startup screen -->
            <ui:LoadingPage Grid.ColumnSpan="2" Visibility="{Binding IsLoading, Converter={StaticResource VVC}}" />
        </Grid>
    </DockPanel>
</UserControl>
