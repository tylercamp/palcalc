<adonisControls:AdonisWindow x:Class="PalCalc.UI.View.AboutWindow"
                             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                             xmlns:v="clr-namespace:PalCalc.UI.View"
                             xmlns:adonisControls="clr-namespace:AdonisUI.Controls;assembly=AdonisUI"
                             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
                             mc:Ignorable="d"
                             ResizeMode="NoResize"
                             SizeToContent="WidthAndHeight"
                             WindowStyle="ToolWindow"
                             Background="{DynamicResource {x:Static adonisUi:Brushes.Layer3BackgroundBrush}}"
                             WindowStartupLocation="CenterOwner"
                             PlaceTitleBarOverContent="True"
                             IconVisibility="Collapsed"
                            >
    <Window.DataContext>
        <v:AboutViewModel />
    </Window.DataContext>
    <StackPanel Orientation="Vertical" Margin="10,10,10,10">
        <StackPanel.Resources>
            <Style TargetType="Label" BasedOn="{StaticResource {x:Type Label}}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
            <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
                <Setter Property="Margin" Value="0,10,0,10" />
            </Style>
        </StackPanel.Resources>

        <Label Content="{Binding Title}" FontWeight="Bold" FontSize="20" />

        <TextBlock Text="by Tyler Camp" />
        <TextBlock>
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/">https://github.com/tylercamp/palcalc/</v:Weblink>
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/issues">Bug Reports</v:Weblink>
            |
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/releases">Releases</v:Weblink>
        </TextBlock>

        <TextBlock FontStyle="Italic" FontSize="11">
            PalCalc is an independent project and is not affiliated with Palworld or Pocket Pair, Inc.
        </TextBlock>
        <TextBlock FontStyle="Italic" FontSize="11">
            All Palworld assets are owned by Pocket Pair, Inc.
        </TextBlock>

        <Separator />

        <Label FontWeight="Bold" FontSize="12">References</Label>
        <TextBlock>
            Latest
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/tree/main/PalCalc.GenDB">data</v:Weblink>
            and
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/tree/main/PalCalc.UI/Resources">Pal icons</v:Weblink>
            scraped using
            <v:Weblink Uri="https://github.com/FabianFG/CUE4Parse">CUE4Parse</v:Weblink>
            (<v:Weblink Uri="https://github.com/FabianFG/CUE4Parse/blob/master/LICENSE">Apache 2 License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            Palworld
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/blob/main/docres/research/palworld-breeding/README.md">mechanics</v:Weblink>
            were
            <v:Weblink Uri="https://github.com/tylercamp/palcalc/blob/main/docres/research/palworld-breeding/REA-GUIDE.md">reverse-engineered</v:Weblink>
            using
            <v:Weblink Uri="https://github.com/morluto/rea">REA</v:Weblink>
            (<v:Weblink Uri="https://github.com/morluto/rea/blob/main/LICENSE">MIT License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            Palworld save support based on
            <v:Weblink Uri="https://github.com/cheahjs/palworld-save-tools">palworld-save-tools</v:Weblink>
            (<v:Weblink Uri="https://github.com/cheahjs/palworld-save-tools/blob/main/LICENSE">MIT License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            Xbox save support based on
            <v:Weblink Uri="https://github.com/Tom60chat/Xbox-Live-Save-Exporter">Xbox-Live-Save-Exporter</v:Weblink>
        </TextBlock>

        <Separator />

        <Label FontWeight="Bold" FontSize="12">Libraries</Label>
        <TextBlock>
            <v:Weblink Uri="https://github.com/benruehl/adonis-ui">Adonis UI - Dark Theme by benruehl</v:Weblink>
            (<v:Weblink Uri="https://github.com/benruehl/adonis-ui/blob/master/LICENSE">MIT License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/serilog/serilog">Serilog</v:Weblink>
            (<v:Weblink Uri="https://github.com/serilog/serilog/blob/dev/LICENSE">Apache 2 License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/vain0x/DotNetKit.Wpf.AutoCompleteComboBox">AutoCompleteComboBox by vain0x</v:Weblink>
            (<v:Weblink Uri="https://github.com/vain0x/DotNetKit.Wpf.AutoCompleteComboBox/blob/main/LICENSE.md">MIT License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/NinetailLabs/GraphSharp">GraphSharp by Various Authors (Defunct, Modified)</v:Weblink>
            (<v:Weblink Uri="https://github.com/NinetailLabs/GraphSharp/blob/master/LICENSE">Apache 2 License</v:Weblink>)
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/YaccConstructor/QuickGraph">QuickGraph by YaccConstructor</v:Weblink>
            (<v:Weblink Uri="https://github.com/YaccConstructor/QuickGraph/blob/master/LICENSE.txt">Ms-PL License</v:Weblink>)
            (<v:Weblink Uri="https://github.com/deepakkumar1984/QuickGraph.NETStandard">.NET Standard Port</v:Weblink>)
        </TextBlock>
        <TextBlock>
            <v:Weblink Uri="https://github.com/zao/ooz">ooz/libooz by zao/rarten</v:Weblink>
            (No license stated)
        </TextBlock>

        <Separator />

        <Label FontWeight="Bold" FontSize="12">Translations</Label>
        <Grid Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition />
                <RowDefinition Height="8" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <Border Grid.Column="1" Grid.RowSpan="999" Width="1" Background="Gray" />

            <!-- zh-Hans -->
            <Label Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center">
                中文 (简体) | zh-Hans
            </Label>
            <StackPanel Grid.Row="0" Grid.Column="2">
                <TextBlock>
                    在这251秒赌上我的一起
                    <v:Weblink Uri="https://github.com/tylercamp/palcalc/pull/70">(1)</v:Weblink>
                </TextBlock>
                <TextBlock>
                    Narugakuruga
                    <v:Weblink Uri="https://github.com/tylercamp/palcalc/pull/87">(1)</v:Weblink>
                </TextBlock>
            </StackPanel>

            <!-- ko -->
            <Label Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center">
                한국어 | ko
            </Label>
            <StackPanel Grid.Row="2" Grid.Column="2">
                <TextBlock>
                    moroa2017
                    <v:Weblink Uri="https://github.com/tylercamp/palcalc/pull/158">(1)</v:Weblink>
                </TextBlock>
            </StackPanel>

            <!-- tr -->
            <Label Grid.Row="4" Grid.Column="0" VerticalContentAlignment="Center">
                Türkçe | tr
            </Label>
            <StackPanel Grid.Row="4" Grid.Column="2">
                <TextBlock>
                    Elderly-Emre
                    <v:Weblink Uri="https://github.com/tylercamp/palcalc/pull/180">(1)</v:Weblink>
                </TextBlock>
            </StackPanel>

            <!-- ja -->
            <Label Grid.Row="6" Grid.Column="0" VerticalContentAlignment="Center">
                日本語 | ja
            </Label>
            <StackPanel Grid.Row="6" Grid.Column="2">
                <TextBlock>
                    yknn-888
                    <v:Weblink Uri="https://github.com/tylercamp/palcalc/pull/240">(1)</v:Weblink>
                </TextBlock>
            </StackPanel>
        </Grid>
    </StackPanel>
</adonisControls:AdonisWindow>
