<UserControl x:Class="PalCalc.UI.View.Pal.PassiveSkillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PalCalc.UI.View.Pal"
             xmlns:mvm="clr-namespace:PalCalc.UI.ViewModel.Mapped"
             xmlns:c="clr-namespace:PalCalc.UI.ViewModel.Converters"
             xmlns:adonisUi="clr-namespace:AdonisUI;assembly=AdonisUI"
             d:Width="80"
             mc:Ignorable="d"
             Height="18"
             TextOptions.TextFormattingMode="Ideal"
             d:DataContext="{x:Static mvm:PassiveSkillViewModel.DesignerInstance_TN3}">
    <UserControl.Resources>
        <ResourceDictionary>
            <mvm:RankColorConverter x:Key="RCC" />
            <c:ValueBoolConverter x:Key="VBC" />

            <ImageBrush x:Key="PassiveSpecialBackgroundBrush"
                        ImageSource="/PalCalc.UI;component/Resources/PassiveSpecialBackground.png"
                        Stretch="Fill"
                        AlignmentX="Left"
                        TileMode="Tile"
                        Viewport="0,0,148.5,18"
                        ViewportUnits="Absolute" />
            <LinearGradientBrush x:Key="PassiveDarkOverlayBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#88111111" Offset="0" />
                <GradientStop Color="#FF111111" Offset="1" />
            </LinearGradientBrush>
            <SolidColorBrush x:Key="BasicPassiveBackgroundBrush"
                             Color="#111217"
                             />
            <SolidColorBrush x:Key="Tier23OverlayBrush" Color="#20FFDD00" />
            <LinearGradientBrush x:Key="Tier4OverlayBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#3D59BB65" Offset="0" />
                <GradientStop Color="#7A5958CC" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="Tier5OverlayBrush" StartPoint="0,0.5" EndPoint="1,0.5">
                <GradientStop Color="#3D59BB65" Offset="0" />
                <GradientStop Color="#7A4D09CB" Offset="1" />
            </LinearGradientBrush>
            <DrawingBrush x:Key="Tier23BackgroundBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource PassiveDarkOverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource Tier23OverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="Tier4BackgroundBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource PassiveDarkOverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource Tier4OverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>
            <DrawingBrush x:Key="Tier5BackgroundBrush" Viewbox="0,0,1,1" ViewboxUnits="Absolute" Stretch="Fill">
                <DrawingBrush.Drawing>
                    <DrawingGroup>
                        <GeometryDrawing Brush="{StaticResource PassiveDarkOverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                        <GeometryDrawing Brush="{StaticResource Tier5OverlayBrush}">
                            <GeometryDrawing.Geometry>
                                <RectangleGeometry Rect="0,0,1,1" />
                            </GeometryDrawing.Geometry>
                        </GeometryDrawing>
                    </DrawingGroup>
                </DrawingBrush.Drawing>
            </DrawingBrush>

            <Style x:Key="SpecialTierBackgroundStyle" TargetType="Rectangle">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Rank}" Value="2">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Fill" Value="{StaticResource Tier23BackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="3">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Fill" Value="{StaticResource Tier23BackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="4">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Fill" Value="{StaticResource Tier4BackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="5">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Fill" Value="{StaticResource Tier5BackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <local:SkillEntryView BorderBrush="{Binding Rank, Converter={StaticResource RCC}}" ToolTipService.ToolTip="{Binding Description.Value}" ToolTipService.ShowOnDisabled="True">
        <local:SkillEntryView.Style>
            <Style TargetType="local:SkillEntryView">
                <Setter Property="Background" Value="{StaticResource BasicPassiveBackgroundBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Description, Converter={StaticResource VBC}}" Value="True">
                        <Setter Property="Cursor" Value="Hand" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="2">
                        <Setter Property="Background" Value="{StaticResource PassiveSpecialBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="3">
                        <Setter Property="Background" Value="{StaticResource PassiveSpecialBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="4">
                        <Setter Property="Background" Value="{StaticResource PassiveSpecialBackgroundBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Rank}" Value="5">
                        <Setter Property="Background" Value="{StaticResource PassiveSpecialBackgroundBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </local:SkillEntryView.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Rectangle Grid.ColumnSpan="3" Style="{StaticResource SpecialTierBackgroundStyle}" IsHitTestVisible="False" />
            
            <!-- Note: No drop shadows on text - they make cached bitmaps extra blurry -->

            <Viewbox Grid.Column="0" StretchDirection="DownOnly" Stretch="Uniform" HorizontalAlignment="Left" Margin="4,2,2,2">
                <TextBlock Text="{Binding Name.Value}" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#f0f0f0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Rank}" Value="2">
                                    <Setter Property="Foreground" Value="#FFFFD83F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rank}" Value="3">
                                    <Setter Property="Foreground" Value="#FFFFD83F" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rank}" Value="4">
                                    <Setter Property="Foreground" Value="#FF68FFD8" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Rank}" Value="5">
                                    <Setter Property="Foreground" Value="#FF68FFD8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Viewbox>
            <Image Grid.Column="2" Margin="1,2,3,2" Width="14" Height="14" Source="{Binding RankIcon}" />
        </Grid>
    </local:SkillEntryView>
</UserControl>
